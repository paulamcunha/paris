{
  "name": "Paris em Cena | Acesso privado",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Paris em Cena (acesso privado)",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postStartCommand": "bash .devcontainer/start-site.sh"
}
